# OpenAI API
OPENAI_API_KEY=sk-your-api-key-here

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_sme
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Storage
CORPUS_BASE_PATH=/home/user/worker-comfyui/storage

# Retrieval Parameters
BM25_K=20
DENSE_K=20
FUSION_K=10
MMR_K=5
MMR_LAMBDA=0.7
CITATIONS_COUNT=3

# LLM Models
DEFAULT_MODEL=gpt-4o-mini
COMPLEX_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Reranking
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=10

# Validation
VALIDATOR_THRESHOLD=0.7

# Memory
CONVERSATION_SUMMARY_INTERVAL=10  # messages
MAX_CONVERSATION_HISTORY=50

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_FORMAT=json  # json or text

# Observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-sme-system
LANGSMITH_TRACING=false

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Performance
ENABLE_CACHE=true
CACHE_TTL=3600
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=300

# Feature Flags (for phased rollout)
ENABLE_RAPTOR=false
ENABLE_GRAPHRAG=false
ENABLE_MEMORY=false
ENABLE_ROUTER=false
ENABLE_VALIDATOR=false
